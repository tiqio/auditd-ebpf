[Unit]
Description=Rust/Aya eBPF audit service
Documentation=man:auditd-ebpf(8)
After=local-fs.target systemd-journald.service
Wants=systemd-journald.service

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=auditd-ebpf-auditors
ExecStart=/usr/sbin/auditd-ebpf run --ebpf-object /usr/lib/auditd-ebpf/auditd-ebpf-ebpf --rules-dir /etc/auditd-ebpf/rules.d
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=auditd-ebpf

# CAP_SYS_ADMIN 只保留为旧内核兼容边界；程序完成能力探测后必须主动删除该回退能力。
# CAP_SETPCAP 仅用于初始化结束时主动清空 bounding set，随后与所有其他 capability 一并删除。
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SETPCAP
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SETPCAP
NoNewPrivileges=yes
LimitMEMLOCK=infinity

# 规则、配置和风险接受记录全部只读。唯一持久可写目录用于 durable dirty/clean 标记。
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadOnlyPaths=/etc/auditd-ebpf
ReadWritePaths=/var/lib/auditd-ebpf
StateDirectory=auditd-ebpf
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
